# Worktrees
.worktrees/

# CodeGraph index
.codegraph/

# Build directories
/build/
/build-*/
cmake-build-*/
/out/
/dist/

# Vendor build artifacts (keep vendor cmake configs tracked via git add -f)
vendor/**/build/
!vendor/**/build/cmake/

# CMake generated files
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
install_manifest.cmake
CTestTestfile.cmake

# Compiled objects
*.o
*.obj
*.lo
*.slo
*.ko
*.elf

# Libraries
*.so
*.so.*
*.dylib
*.dll
*.a
*.lib
*.lai
*.la

# Executables
*.exe
*.out
*.app
*.i*86
*.x86_64
*.hex

# Platform-specific
.DS_Store
Thumbs.db
Desktop.ini

# IDE
.vscode/
.idea/
*.swp
*.swo
*~
.vs/
*.vcxproj.user
*.suo
*.user

# Cursor AI configuration
.cursorrules
.cursor/
query_saturn.py

# AI agent workspaces / session notes
.superpowers/
.codewhale/
codewhale/

# vcpkg
vcpkg_installed/
vcpkg/downloads/
vcpkg/buildtrees/
vcpkg/packages/

# Dependencies (node only - vendor/ is tracked for this project)
# vendor/  # Tracked - contains vendored C++ libraries
third_party/
node_modules/

# ROMs and BIOS files (NEVER commit copyrighted content!)
# NOTE: git does not support trailing comments; keep comments on their own line.
# Sega Saturn BIOS (sega_101.bin, mpr-17933.bin, etc.)
*.bin
*.bios
# ROM cartridge dumps (e.g. mpr-18811-mx.ic1)
*.ic[0-9]
# RetroArch system directory
system/
bios/

# ROM images
roms/
*.chd
*.cue
*.iso
*.ccd
*.img
*.mds
*.mdf
*.m3u

# Save states and saves
*.srm
*.state
*.sav
# Ymir backup RAM files
*.bup
# Ymir SMPC persistent data (RTC)
*.smpc
saves/
states/

# Logs
*.log
logs/

# Core dump files (Unix) - be specific to avoid ignoring src/core/
/core
core.[0-9]*

# Testing (exclude copyrighted test materials)
tests/roms/
tests/bios/
tests/system/

# Test fixtures - BIOS and ROM files
# BIOS files (sega_101.bin, sega_100.bin, etc.)
tests/fixtures/*.bin
tests/fixtures/*.bios
tests/fixtures/*.ic[0-9]
tests/fixtures/*.iso
tests/fixtures/*.cue
tests/fixtures/*.chd
tests/fixtures/*.ccd
tests/fixtures/*.mds
tests/fixtures/games/

# Test coverage
*.coverage
coverage/

# Documentation
docs/

# Block all root-level markdown files except standard ones
/*.md
!README.md
!CONTRIBUTING.md
!CHANGELOG.md
!LICENSE.md
!ROADMAP.md

# Packaging
*.deb
*.rpm
*.tar.gz
*.tar.xz
*.zip
packaging/output/

# Temporary files
tmp/
temp/
*.tmp
*.temp

# Python (for scripts)
__pycache__/
*.py[cod]
*$py.class
.Python
pip-log.txt

# Backup files
*.bak
*.backup
*~

# Compiled shader bytecode (regenerated from .glsl via compile_shaders.ps1)
*.spv

# Benchmark output
benchmark_results/

# Generated files
version.h
build_info.h

# Profile data
profile/
*.prof
*.profdata

# Machine-specific utility scripts
deploy-retroarch.ps1
check_gpu_dependencies.ps1

